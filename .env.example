# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Server ---
PORT=3000

# --- Database (MongoDB Atlas) ---
# Required. Atlas -> Cluster -> Connect -> Drivers -> copy the connection string,
# then replace <password> with the database user's password.
#
#   MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#
# Used both locally and in production — there is deliberately no local fallback,
# because silently defaulting to another store is how you end up with a deployment
# that looks healthy and quietly loses data.
#
# Atlas note: Vercel has no static egress IP on the Hobby plan, so the Atlas
# Network Access allowlist needs 0.0.0.0/0 for the deployed function to connect.
MONGODB_URI=

# Optional: database name. Defaults to the path in the URI, or "carecloud".
# Point the test suite at a throwaway database by setting this to carecloud_test.
MONGODB_DB=carecloud

# Optional: also append structured JSON logs here. Ignored on Vercel, whose
# filesystem is read-only — stdout is the log destination in production.
# LOG_FILE=logs/agent.log

# --- Vapi ---
# Dashboard -> Organization -> API Keys -> "Private Key" (server-side key).
VAPI_API_KEY=

# Public HTTPS URL of this server's webhook, e.g.
#   https://your-project.vercel.app/vapi/webhook
# Used by scripts/deployAssistant.js. Must include the /vapi/webhook path.
SERVER_URL=

# Shared secret. If set, the server rejects any webhook whose x-vapi-secret
# header doesn't match, and deployAssistant.js registers it with Vapi so Vapi
# attaches it to every request. Any random string. Strongly recommended —
# without it the webhook accepts requests from anyone who learns the URL.
VAPI_SERVER_SECRET=

# Leave blank to CREATE a new assistant. Paste an existing id to UPDATE it in
# place (otherwise every deploy piles up another duplicate assistant).
VAPI_ASSISTANT_ID=

# --- Model ---
# Any Vapi-supported model. gpt-4o follows the long intake prompt and the tool
# contract more reliably than gpt-4o-mini, which is worth the extra latency here.
LLM_MODEL=gpt-4o

# Deepgram model used for transcription. nova-2-phonecall is tuned for 8kHz
# telephony audio, which matters for names and spelled-out letters.
TRANSCRIBER_MODEL=nova-2-phonecall

# --- Voice ---
# Voice availability is account-specific: a valid-looking ID from the docs can
# still 400. Run `npm run probe:voices` to list what your account accepts.
# vapi/Elliot needs no third-party provider credential.
VOICE_PROVIDER=vapi
VOICE_ID=Elliot

# --- Tests ---
# Point the test scripts at a deployed instance instead of localhost.
# TEST_BASE_URL=https://your-project.vercel.app
