{
  "name": "carecloud-voice-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Voice AI patient registration: Vapi phone agent + REST API + libSQL",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "deploy:assistant": "node scripts/deployAssistant.js",
    "vercel:env": "node scripts/pushVercelEnv.js",
    "preflight": "node scripts/preflight.js",
    "probe:voices": "node scripts/probeVoices.js",
    "test": "npm run test:persistence && npm run test:api && npm run test:webhook",
    "test:api": "node scripts/testApi.js",
    "test:webhook": "node scripts/testWebhook.js",
    "test:persistence": "node scripts/testPersistence.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongodb": "^7.5.0"
  }
}
